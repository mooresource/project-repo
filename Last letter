-- NEW: Enhanced word usage tracking
local function markWordAsUsed(word)
    local currentTime = tick()
    
    -- Mark as used
    usedWords[word] = true
    
    -- Track detailed usage
    if not usedWordsHistory[word] then
        usedWordsHistory[word] = {
            count = 0,
            firstUsed = currentTime,
            lastUsed = currentTime
        }
    end
    
    usedWordsHistory[word].count = usedWordsHistory[word].count + 1
    usedWordsHistory[word].lastUsed = currentTime
    
    -- Update usage counter
    local usedCount = 0
    for _ in pairs(usedWords) do
        usedCount = usedCount + 1
    end
    usageLabel.Text = "Used Words: " .. usedCount
    
    print("[WORD USED] " .. word .. " (Total uses: " .. usedWordsHistory[word].count .. ")")
end

-- NEW: Better detection of successful word submission
local function detectSuccessfulSubmission()
    local success, result = pcall(function()
        local inGameGui = playerGui:FindFirstChild("InGame")
        if not inGameGui then return false end
        
        local frame = inGameGui:FindFirstChild("Frame")
        if not frame then return false end
        
        local tries = frame:FindFirstChild("Tries")
        if not tries then return false end
        
        -- Check if latest try is correct (green checkmark)
        for i = 1, 5 do
            local tryImage = tries:FindFirstChild(tostring(i))
            if tryImage and tryImage:IsA("ImageLabel") then
                if tryImage.Image == CORRECT_ANSWER_IMAGE then
                    return true -- Found a correct answer
                end
            end
        end
        
        return false
    end)
    
    return success and result
end

local function buildPrefixIndex()
    wordsByPrefix = {}
    for _, word in ipairs(allWords) do
        for i = 1, math.min(#word, 10) do
            local prefix = word:sub(1, i)
            if not wordsByPrefix[prefix] then
                wordsByPrefix[prefix] = {}
            end
            table.insert(wordsByPrefix[prefix], word)
        end
    end
end

local function loadFromJSON(content)
    local success, wordsJson = pcall(function()
        return HttpService:JSONDecode(content)
    end)
    if not success then return false end
    for word, _ in pairs(wordsJson) do
        local len = #word
        local lowerWord = word:lower()
        if len >= CONFIG.minLength and len <= CONFIG.maxLength then
            if len > 20 or not commonWords[lowerWord] then
                table.insert(allWords, lowerWord)
            end
        end
    end
    return true
end

local function loadFromText(content)
    for word in content:gmatch("[^\r\n]+") do
        local len = #word
        local lowerWord = word:lower()
        if len >= CONFIG.minLength and len <= CONFIG.maxLength then
            if len > 20 or not commonWords[lowerWord] then
                table.insert(allWords, lowerWord)
            end
        end
    end
    return #allWords > 0
end

local function loadDictionary()
    searchBox.PlaceholderText = "LOADING..."
    statusLabel.Text = "Status: Loading Dictionary..."
    statusLabel.TextColor3 = Color3.fromRGB(255, 255, 100)
    
    for i, url in ipairs(DICTIONARY_URLS) do
        local ok, content = pcall(function() return game:HttpGet(url) end)
        if ok then
            local loaded = false
            if content:match("^%s*{") then loaded = loadFromJSON(content)
            else loaded = loadFromText(content) end
            
            if loaded then
                buildPrefixIndex()
                searchBox.PlaceholderText = "TYPE OR WAIT..."
                statusLabel.Text = "Words: " .. #allWords .. " | Platform: PC"
                statusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
                return true
            end
        end
    end
    
    searchBox.PlaceholderText = "ERROR LOADING"
    statusLabel.Text = "Status: ERROR"
    statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
    return false
end

local function clearCurrentWord()
    if isBackspacing then
        return
    end
    
    isBackspacing = true
    print("[BACKSPACE] Starting deletion...")
    
    task.spawn(function()
        for i = 1, 30 do
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Backspace, false, game)
            task.wait(0.02)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Backspace, false, game)
            task.wait(0.02)
        end
        
        task.wait(CONFIG.backspaceDelay)
        isBackspacing = false
        print("[BACKSPACE] Deletion completed!")
    end)
end

