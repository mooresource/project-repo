local function createSlider(name, yPos, minVal, maxVal, defaultVal, increment, callback)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, -10, 0, 50)
    container.Position = UDim2.new(0, 5, 0, yPos)
    container.BackgroundTransparency = 1
    container.Parent = configFrame
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 18)
    label.Position = UDim2.new(0, 0, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = name .. ": " .. tostring(defaultVal)
    label.TextColor3 = Color3.fromRGB(200, 200, 200)
    label.Font = Enum.Font.Code
    label.TextSize = 11
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = container
    
    local sliderBack = Instance.new("Frame")
    sliderBack.Size = UDim2.new(1, 0, 0, 6)
    sliderBack.Position = UDim2.new(0, 0, 0, 22)
    sliderBack.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    sliderBack.BorderColor3 = Color3.fromRGB(80, 80, 80)
    sliderBack.BorderSizePixel = 1
    sliderBack.Parent = container
    
    local sliderFill = Instance.new("Frame")
    sliderFill.Size = UDim2.new((defaultVal - minVal) / (maxVal - minVal), 0, 1, 0)
    sliderFill.BackgroundColor3 = Color3.fromRGB(100, 255, 100)
    sliderFill.BorderSizePixel = 0
    sliderFill.Parent = sliderBack
    
    local minusBtn = Instance.new("TextButton")
    minusBtn.Size = UDim2.new(0, 30, 0, 18)
    minusBtn.Position = UDim2.new(0, 0, 0, 32)
    minusBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    minusBtn.BorderColor3 = Color3.fromRGB(100, 100, 100)
    minusBtn.BorderSizePixel = 1
    minusBtn.Text = "-"
    minusBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    minusBtn.Font = Enum.Font.Code
    minusBtn.TextSize = 14
    minusBtn.Parent = container
    
    local plusBtn = Instance.new("TextButton")
    plusBtn.Size = UDim2.new(0, 30, 0, 18)
    plusBtn.Position = UDim2.new(1, -30, 0, 32)
    plusBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    plusBtn.BorderColor3 = Color3.fromRGB(100, 100, 100)
    plusBtn.BorderSizePixel = 1
    plusBtn.Text = "+"
    plusBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    plusBtn.Font = Enum.Font.Code
    plusBtn.TextSize = 14
    plusBtn.Parent = container
    
    local currentValue = defaultVal
    
    local function updateValue(newValue)
        newValue = math.clamp(newValue, minVal, maxVal)
        currentValue = math.floor((newValue / increment) + 0.5) * increment
        label.Text = name .. ": " .. string.format("%.2f", currentValue)
        sliderFill.Size = UDim2.new((currentValue - minVal) / (maxVal - minVal), 0, 1, 0)
        callback(currentValue)
    end
    
    minusBtn.MouseButton1Click:Connect(function()
        updateValue(currentValue - increment)
    end)
    
    plusBtn.MouseButton1Click:Connect(function()
        updateValue(currentValue + increment)
    end)
    
    local dragging = false
    
    sliderBack.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            local mouseX = input.Position.X
            local sliderX = sliderBack.AbsolutePosition.X
            local sliderWidth = sliderBack.AbsoluteSize.X
            local percent = math.clamp((mouseX - sliderX) / sliderWidth, 0, 1)
            local newValue = minVal + (percent * (maxVal - minVal))
            updateValue(newValue)
        end
    end)
    
    sliderBack.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local mouseX = input.Position.X
            local sliderX = sliderBack.AbsolutePosition.X
            local sliderWidth = sliderBack.AbsoluteSize.X
            local percent = math.clamp((mouseX - sliderX) / sliderWidth, 0, 1)
            local newValue = minVal + (percent * (maxVal - minVal))
            updateValue(newValue)
        end
    end)
end

