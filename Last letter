            btn.BorderColor3 = Color3.fromRGB(80, 80, 80)
            btn.TextColor3 = Color3.fromRGB(200, 200, 200)
        end
        
        btn.BorderSizePixel = 1
        
        -- Display usage count if word has been used
        local displayText = word:upper()
        if isBanned then
            displayText = displayText .. " [BANNED]"
        elseif isUsed and usedWordsHistory[word] then
            displayText = displayText .. " (x" .. usedWordsHistory[word].count .. ")"
        end
        
