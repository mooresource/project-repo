-- Functions
local function notify(message)
	pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = "Word Helper",
			Text = message,
			Duration = 1
		})
	end)
end

local function loadFromJSON(content)
	local success, wordsJson = pcall(function()
		return HttpService:JSONDecode(content)
	end)
	if not success then return false end
	for word, _ in pairs(wordsJson) do
		local len = #word
		local lowerWord = word:lower()
		if len >= CONFIG.minLength and len <= CONFIG.maxLength then
			if len > 20 or not commonWords[lowerWord] then
				table.insert(allWords, lowerWord)
			end
		end
	end
	return true
end

local function loadFromText(content)
	for word in content:gmatch("[^\r\n]+") do
		local len = #word
		local lowerWord = word:lower()
		if len >= CONFIG.minLength and len <= CONFIG.maxLength then
			if len > 20 or not commonWords[lowerWord] then
				table.insert(allWords, lowerWord)
			end
		end
	end
	return #allWords > 0
end

local function loadDictionary()
	searchBox.PlaceholderText = "LOADING..."
	statusLabel.Text = "Status: Loading Dictionary..."
	statusLabel.TextColor3 = Color3.fromRGB(255, 255, 100)
	
	for i, url in ipairs(DICTIONARY_URLS) do
		local ok, content = pcall(function() return game:HttpGet(url) end)
		if ok then
			local loaded = false
			if content:match("^%s*{") then loaded = loadFromJSON(content)
			else loaded = loadFromText(content) end
			
			if loaded then
				searchBox.PlaceholderText = "TYPE OR WAIT..."
				statusLabel.Text = "Words: " .. #allWords .. " | Platform: " .. (isMobile and "MOBILE" or "PC")
				statusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
				notify("Loaded " .. #allWords .. " words")
				return true
			end
		end
	end
	
	searchBox.PlaceholderText = "ERROR LOADING"
	statusLabel.Text = "Status: ERROR"
	statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
	return false
end

local function autoTypeWord(word, currentInput)
	local remaining = word:sub(#currentInput + 1)
	task.spawn(function()
		local cam = workspace.CurrentCamera
		local size = cam.ViewportSize
		local x, y = size.X/2, size.Y/2
		
		for _ = 1,2 do
			VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
			task.wait()
			VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
			task.wait()
		end

		for c in remaining:upper():gmatch(".") do
			VirtualInputManager:SendKeyEvent(true, Enum.KeyCode[c], false, game)
			task.wait(CONFIG.typingSpeed)
			VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[c], false, game)
		end
		
		task.wait(0.1)
		VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
	end)
end

local function displayPage()
	for _, c in ipairs(resultsFrame:GetChildren()) do
		if c:IsA("TextButton") then c:Destroy() end
	end

	local startIdx = (currentPage-1)*CONFIG.wordsPerPage + 1
	local endIdx = math.min(currentPage*CONFIG.wordsPerPage, #topWords)
	
	local totalPages = math.ceil(#topWords/CONFIG.wordsPerPage)
	pageLabel.Text = "PAGE " .. currentPage .. " / " .. totalPages

	for i = startIdx, endIdx do
		local word = topWords[i]
		local isTopResult = (i == startIdx)
		
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, -6, 0, isTopResult and 28 or 22)
		btn.BackgroundColor3 = isTopResult and Color3.fromRGB(40, 60, 40) or Color3.fromRGB(40, 40, 40)
		btn.BorderColor3 = isTopResult and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(80, 80, 80)
		btn.BorderSizePixel = 1
		btn.Text = word:upper()
		btn.Font = Enum.Font.Code
		btn.TextSize = isTopResult and 13 or 11
		btn.TextColor3 = isTopResult and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(200, 200, 200)
		btn.AutoButtonColor = true
		btn.TextScaled = #word > 25
		btn.Parent = resultsFrame
		
		btn.MouseButton1Click:Connect(function()
			usedWords[word] = true
			autoTypeWord(word, searchBox.Text)
			searchBox.Text = ""
			topWords = {}
			displayPage()
		end)
	end
end

local function updateTopWords(input)
	topWords = {}
	input = input:lower()
	
	if input == "" then
		displayPage()
		return
	end

	for _, w in ipairs(allWords) do
		if w:sub(1, #input) == input and w ~= input and not usedWords[w] then
			table.insert(topWords, w)
		end
	end

	table.sort(topWords, function(a, b)
		local lenA, lenB = #a, #b
		local distA = math.abs(lenA - CONFIG.idealLength)
		local distB = math.abs(lenB - CONFIG.idealLength)
		if distA == distB then return lenA < lenB end
		return distA < distB
	end)

	currentPage = 1
	displayPage()
end

