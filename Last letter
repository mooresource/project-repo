local function extractLetters(message)
    local pattern = "Word:%s*([A-Z][A-Z]?[A-Z]?[A-Z]?)"
    return string.match(message, pattern)
end

LogService.MessageOut:Connect(function(message, messageType)
    if string.find(message, "Word:") then
        local letters = extractLetters(message)
        if letters and consoleAutoComplete then
            lastWordTime = tick()
            searchBox.Text = letters
        end
    end
end)

local function getLettersFromUI()
    local success, result = pcall(function()
        local inGameGui = playerGui:FindFirstChild("InGame") 
        if not inGameGui then return nil end
        
        local frame = inGameGui:FindFirstChild("Frame")
        if not frame then return nil end
        
        local currentWord = frame:FindFirstChild("Current word") or 
                           frame:FindFirstChild("Currentword") or 
                           frame:FindFirstChild("CurrentWord")
        
        if not currentWord then
            for _, child in ipairs(frame:GetChildren()) do
                if child:IsA("Frame") and child:FindFirstChild("1") then
                    currentWord = child
                    break
                end
            end
        end
        
        if not currentWord then return nil end
        
        local letters = {}
        for i = 1, 20 do
            local letterFrame = currentWord:FindFirstChild(tostring(i))
            if letterFrame then
                local letterLabel = letterFrame:FindFirstChild("Letter")
                if letterLabel and letterLabel:IsA("TextLabel") then
                    local letter = letterLabel.Text
                    if letter and letter ~= "" then
                        table.insert(letters, letter:upper())
                    end
                end
            else
                break
            end
        end
        
        return #letters > 0 and table.concat(letters, "") or nil
    end)
    
    return success and result or nil
end

task.spawn(function()
    task.wait(2)
    
    while task.wait(0.1) do
        if autoPlayEnabled and isAutoPlaying and currentAttemptWord ~= "" then
            local currentWrongCount = getWrongTryCount()
            
            if currentWrongCount > lastWrongTryCount then
                bannedWords[currentAttemptWord] = true
                print("[AUTO PLAY] Banned: " .. currentAttemptWord)
                
                lastWrongTryCount = currentWrongCount
                
                while isBackspacing do
                    task.wait(0.1)
                end
                
                clearCurrentWord()
                
                while isBackspacing do
                    task.wait(0.1)
                end
                
                task.wait(CONFIG.autoPlayRetryDelay)
                
                print("[AUTO PLAY] Searching for new word...")
                
                local letters = getLettersFromUI()
                if letters and isMyTurn() then
                    updateTopWords(letters)
                    local newBestWord = getBestWord(letters)
                    
                    if newBestWord then
                        print("[AUTO PLAY] Retrying: " .. newBestWord)
                        currentAttemptWord = newBestWord
                        autoTypeWord(newBestWord, letters)
                    else
                        print("[AUTO PLAY] No valid words")
                        isAutoPlaying = false
                        currentAttemptWord = ""
                    end
                else
                    isAutoPlaying = false
                    currentAttemptWord = ""
                end
            end
        end
    end
end)

task.spawn(function()
    local lastDetectedLetters = ""
    local wasMyTurn = false
    task.wait(2)
    
    while task.wait(0.1) do 
        if uiAutoComplete or autoPlayEnabled then
            local currentlyMyTurn = isMyTurn()
            
            if currentlyMyTurn then
                if not wasMyTurn then
                    task.wait(CONFIG.turnSettlingTime)
                    wasMyTurn = true
                    lastWrongTryCount = getWrongTryCount()
                end
                
                local currentLetters = getLettersFromUI()
                
                if currentLetters and currentLetters ~= "" and currentLetters ~= lastDetectedLetters then
                    lastDetectedLetters = currentLetters
                    lastWordTime = tick()
                    
                    -- Only update search box if not in auto-play mode
                    if not autoPlayEnabled then
                        searchBox.Text = currentLetters
                    end
                    
                    if autoPlayEnabled and not isAutoPlaying then
                        isAutoPlaying = true
                        updateTopWords(currentLetters)
                        task.wait(CONFIG.autoPlayDelay)
                        
                        if isMyTurn() then
                            local bestWord = getBestWord(currentLetters)
                            if bestWord and bestWord ~= lastAutoPlayedWord then
                                lastAutoPlayedWord = bestWord
                                currentAttemptWord = bestWord
                                local modeText = useCommonWords and "Common" or "Default"
                                print("[AUTO PLAY] Attempting: " .. bestWord .. " [" .. modeText .. "]")
                                autoTypeWord(bestWord, currentLetters)
                                
                                task.wait(CONFIG.wrongAnswerCheckDelay)
                                
                                if not isMyTurn() then
                                    print("[AUTO PLAY] Success")
                                    isAutoPlaying = false
                                    currentAttemptWord = ""
                                    searchBox.Text = ""
                                    topWords = {}
                                    displayPage()
                                end
                            else
                                isAutoPlaying = false
                                currentAttemptWord = ""
                            end
                        else
                            isAutoPlaying = false
                            currentAttemptWord = ""
                        end
                    end
                end
            else
                wasMyTurn = false
                isAutoPlaying = false
                if lastDetectedLetters ~= "" then
                    lastDetectedLetters = "" 
                    lastAutoPlayedWord = ""
                    currentAttemptWord = ""
                end
            end
        else
            wasMyTurn = false
            isAutoPlaying = false
            lastDetectedLetters = ""
            lastAutoPlayedWord = ""
            currentAttemptWord = ""
        end
    end
end)

