local function updateCounters()
    local usedCount = 0
    for _ in pairs(usedWords) do
        usedCount = usedCount + 1
    end
    usageLabel.Text = "Used Words: " .. usedCount
    
    local bannedCount = 0
    for _ in pairs(bannedWords) do
        bannedCount = bannedCount + 1
    end
    bannedLabel.Text = "Banned Words: " .. bannedCount
end

local function markWordAsUsed(word)
    local currentTime = tick()
    
    usedWords[word] = true
    
    if not usedWordsHistory[word] then
        usedWordsHistory[word] = {
            count = 0,
            firstUsed = currentTime,
            lastUsed = currentTime
        }
    end
    
    usedWordsHistory[word].count = usedWordsHistory[word].count + 1
    usedWordsHistory[word].lastUsed = currentTime
    
    updateCounters()
    
    print("[WORD USED] " .. word .. " (Total: " .. usedWordsHistory[word].count .. ")")
end

local function buildPrefixIndex()
    wordsByPrefix = {}
    for _, word in ipairs(allWords) do
        for i = 1, math.min(#word, 10) do
            local prefix = word:sub(1, i)
            if not wordsByPrefix[prefix] then
                wordsByPrefix[prefix] = {}
            end
            table.insert(wordsByPrefix[prefix], word)
        end
    end
end

local function loadFromJSON(content)
    local success, wordsJson = pcall(function()
        return HttpService:JSONDecode(content)
    end)
    if not success then return false end
    for word, _ in pairs(wordsJson) do
        local len = #word
        local lowerWord = word:lower()
        if len >= CONFIG.minLength and len <= CONFIG.maxLength then
            table.insert(allWords, lowerWord)
        end
    end
    return true
end

local function loadFromText(content)
    for word in content:gmatch("[^\r\n]+") do
        local len = #word
        local lowerWord = word:lower()
        if len >= CONFIG.minLength and len <= CONFIG.maxLength then
            table.insert(allWords, lowerWord)
        end
    end
    return #allWords > 0
end

local function loadCommonWords()
    print("[LOADING] Common words...")
    local ok, content = pcall(function() return game:HttpGet(COMMON_WORDS_URL) end)
    if ok then
        local count = 0
        for word in content:gmatch("[^\r\n]+") do
            local len = #word
            local lowerWord = word:lower()
            if len >= CONFIG.minLength and len <= CONFIG.maxLength then
                commonWords[lowerWord] = true
                count = count + 1
            end
        end
        print("[LOADED] " .. count .. " common words")
        return true
    else
        print("[ERROR] Failed to load common words")
        return false
    end
end

local function loadDictionary()
    searchBox.PlaceholderText = "LOADING..."
    statusLabel.Text = "Loading Dictionary..."
    statusLabel.TextColor3 = Color3.fromRGB(255, 255, 100)
    
    loadCommonWords()
    
    for i, url in ipairs(DICTIONARY_URLS) do
        local ok, content = pcall(function() return game:HttpGet(url) end)
        if ok then
            local loaded = false
            if content:match("^%s*{") then loaded = loadFromJSON(content)
            else loaded = loadFromText(content) end
            
            if loaded then
                buildPrefixIndex()
                searchBox.PlaceholderText = "TYPE OR WAIT..."
                statusLabel.Text = "Words Loaded: " .. #allWords
                statusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
                return true
            end
        end
    end
    
    searchBox.PlaceholderText = "ERROR"
    statusLabel.Text = "Loading Failed"
    statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
    return false
end

local function clearCurrentWord()
    if isBackspacing then
        return
    end
    
    isBackspacing = true
    print("[BACKSPACE] Clearing word...")
    
    task.spawn(function()
        for i = 1, 30 do
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Backspace, false, game)
            task.wait(0.02)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Backspace, false, game)
            task.wait(0.02)
        end
        
        task.wait(CONFIG.backspaceDelay)
        isBackspacing = false
        print("[BACKSPACE] Complete")
    end)
end

local function autoTypeWord(word, currentInput)
    local remaining = word:sub(#currentInput + 1)
    
    task.spawn(function()
        -- Random delay before starting (humanization)
        local randomDelay = math.random() * (CONFIG.randomDelayMax - CONFIG.randomDelayMin) + CONFIG.randomDelayMin
        task.wait(randomDelay)
        
        local cam = workspace.CurrentCamera
        local size = cam.ViewportSize
        local x, y = size.X/2, size.Y/2
        
        for _ = 1,2 do
            VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
            task.wait()
            VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
            task.wait()
        end

        for i, c in ipairs(remaining:upper():split("")) do
            -- Check if we should make a typo (humanization)
            local shouldTypo = math.random() < CONFIG.typoChance and i > 1
            
            if shouldTypo then
                -- Type a random wrong letter
                local wrongKeys = {"Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P", "A", "S", "D", "F", "G", "H", "J", "K", "L", "Z", "X", "C", "V", "B", "N", "M"}
                local wrongKey = wrongKeys[math.random(#wrongKeys)]
                
                -- Type wrong key
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode[wrongKey], false, game)
                local typoSpeed = CONFIG.typingSpeed + (math.random() - 0.5) * CONFIG.typingSpeedVariation
                task.wait(typoSpeed)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[wrongKey], false, game)
                
                -- Pause (realization delay)
                task.wait(0.1 + math.random() * 0.15)
                
                -- Delete wrong key
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Backspace, false, game)
                task.wait(0.05)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Backspace, false, game)
                task.wait(0.05)
            end
            
            -- Type the correct key with speed variation (humanization)
            local charSpeed = CONFIG.typingSpeed + (math.random() - 0.5) * CONFIG.typingSpeedVariation
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode[c], false, game)
            task.wait(charSpeed)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[c], false, game)
        end
        
        task.wait(0.1)
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
        
        task.wait(0.2)
        markWordAsUsed(word)
    end)
end

local function displayPage()
    for _, c in ipairs(resultsFrame:GetChildren()) do
        if c:IsA("TextButton") then c:Destroy() end
    end

    local startIdx = (currentPage-1)*CONFIG.wordsPerPage + 1
    local endIdx = math.min(currentPage*CONFIG.wordsPerPage, #topWords)
    
    local totalPages = math.ceil(#topWords/CONFIG.wordsPerPage)
    pageLabel.Text = "PAGE " .. currentPage .. " / " .. totalPages

    for i = startIdx, endIdx do
        local word = topWords[i]
        local isTopResult = (i == startIdx)
        local isBanned = bannedWords[word]
        local isUsed = usedWords[word]
        local isCommon = commonWords[word]
        
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -6, 0, isTopResult and 28 or 22)
        
        if isBanned then
            btn.BackgroundColor3 = Color3.fromRGB(60, 30, 30)
            btn.BorderColor3 = Color3.fromRGB(255, 100, 100)
            btn.TextColor3 = Color3.fromRGB(255, 100, 100)
        elseif isUsed then
            btn.BackgroundColor3 = Color3.fromRGB(60, 60, 30)
            btn.BorderColor3 = Color3.fromRGB(255, 255, 100)
            btn.TextColor3 = Color3.fromRGB(255, 255, 100)
        elseif isCommon then
            btn.BackgroundColor3 = Color3.fromRGB(30, 50, 70)
            btn.BorderColor3 = Color3.fromRGB(100, 150, 255)
            btn.TextColor3 = Color3.fromRGB(150, 200, 255)
        elseif isTopResult then
            btn.BackgroundColor3 = Color3.fromRGB(40, 60, 40)
            btn.BorderColor3 = Color3.fromRGB(100, 255, 100)
            btn.TextColor3 = Color3.fromRGB(100, 255, 100)
        else
            btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
            btn.BorderColor3 = Color3.fromRGB(80, 80, 80)
            btn.TextColor3 = Color3.fromRGB(200, 200, 200)
        end
        
        btn.BorderSizePixel = 1
        
        local displayText = word:upper()
        if isBanned then
            displayText = "[BANNED] " .. displayText
        elseif isUsed and usedWordsHistory[word] then
            displayText = "[USED x" .. usedWordsHistory[word].count .. "] " .. displayText
        elseif isCommon then
            displayText = "[COMMON] " .. displayText
        end
        
        btn.Text = displayText
        btn.Font = Enum.Font.Code
        btn.TextSize = isTopResult and 13 or 11
        btn.AutoButtonColor = true
        btn.TextScaled = #displayText > 30
        btn.Parent = resultsFrame
        
        btn.MouseButton1Click:Connect(function()
            if not isBanned then
                autoTypeWord(word, searchBox.Text)
                searchBox.Text = ""
                topWords = {}
                displayPage()
            end
        end)
    end
end

local function updateTopWords(input)
    topWords = {}
    input = input:lower()
    
    if input == "" then
        displayPage()
        return
    end

    local candidateWords = wordsByPrefix[input] or allWords
    local maxResults = 100
    local count = 0
    
    for _, w in ipairs(candidateWords) do
        if count >= maxResults then break end
        if w:sub(1, #input) == input and w ~= input then
            table.insert(topWords, w)
            count = count + 1
        end
    end

    table.sort(topWords, function(a, b)
        local aBanned = bannedWords[a] or false
        local bBanned = bannedWords[b] or false
        local aUsed = usedWords[a] or false
        local bUsed = usedWords[b] or false
        local aCommon = commonWords[a] or false
        local bCommon = commonWords[b] or false
        
        if aBanned ~= bBanned then
            return not aBanned
        end
        
        if aUsed ~= bUsed then
            return not aUsed
        end
        
        if useCommonWords then
            if aCommon ~= bCommon then
                return aCommon
            end
        end
        
        local lenA, lenB = #a, #b
        local distA = math.abs(lenA - CONFIG.idealLength)
        local distB = math.abs(lenB - CONFIG.idealLength)
        if distA == distB then return lenA < lenB end
        return distA < distB
    end)

    currentPage = 1
    displayPage()
    updateCounters()
end

local function isMyTurn()
	local success, result = pcall(function()
		local inGameGui = playerGui:FindFirstChild("InGame")
		if not inGameGui then return false end
		
		local frame = inGameGui:FindFirstChild("Frame")
		if not frame then return false end
		
		local typeLabel = frame:FindFirstChild("Type")
		if not typeLabel or not typeLabel:IsA("TextLabel") then return false end
		
		local text = typeLabel.Text
		local myName = player.Name
		
		return string.find(text, myName) ~= nil
	end)
	
	return success and result or false
end

local function getWrongTryCount()
    local success, count = pcall(function()
        local inGameGui = playerGui:FindFirstChild("InGame")
        if not inGameGui then return 0 end
        
        local frame = inGameGui:FindFirstChild("Frame")
        if not frame then return 0 end
        
        local tries = frame:FindFirstChild("Tries")
        if not tries then return 0 end
        
        local wrongCount = 0
        for i = 1, 5 do
            local tryImage = tries:FindFirstChild(tostring(i))
            if tryImage and tryImage:IsA("ImageLabel") then
                if tryImage.Image == WRONG_ANSWER_IMAGE then
                    wrongCount = wrongCount + 1
                end
            end
        end
        
        return wrongCount
    end)
    
    return success and count or 0
end

local function getBestWord(input)
    if useCommonWords then
        for _, word in ipairs(topWords) do
            if not bannedWords[word] and commonWords[word] then
                if not ignoreUsedWords or not usedWords[word] then
                    return word
                end
            end
        end
        for _, word in ipairs(topWords) do
            if not bannedWords[word] then
                if not ignoreUsedWords or not usedWords[word] then
                    return word
                end
            end
        end
    else
        for _, word in ipairs(topWords) do
            if not bannedWords[word] then
                if not ignoreUsedWords or not usedWords[word] then
                    return word
                end
            end
        end
    end
    return nil
end

