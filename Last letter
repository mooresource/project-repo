-- Console auto-complete
local function extractLetters(message)
	local pattern = "Word:%s*([A-Z][A-Z]?[A-Z]?[A-Z]?)"
	return string.match(message, pattern)
end

LogService.MessageOut:Connect(function(message, messageType)
	if string.find(message, "Word:") then
		local letters = extractLetters(message)
		if letters and consoleAutoComplete then
			lastWordTime = tick()
			searchBox.Text = letters
		end
	end
end)

-- UI Letter Detection
local function getLettersFromUI()
	local success, result = pcall(function()
		local inGameGui = playerGui:WaitForChild("InGame", 1)
		if not inGameGui then return nil end
		
		local frame = inGameGui:FindFirstChild("Frame")
		if not frame then return nil end
		
		local currentWord = frame:FindFirstChild("Current word")
		if not currentWord then
			currentWord = frame:FindFirstChild("Currentword")
		end
		if not currentWord then
			currentWord = frame:FindFirstChild("CurrentWord")
		end
		if not currentWord then
			for _, child in ipairs(frame:GetChildren()) do
				if child:IsA("Frame") and child:FindFirstChild("1") then
					currentWord = child
					break
				end
			end
		end
		
		if not currentWord then return nil end
		
		local letters = {}
		for i = 1, 20 do
			local letterFrame = currentWord:FindFirstChild(tostring(i))
			if letterFrame then
				local letterLabel = letterFrame:FindFirstChild("Letter")
				if letterLabel and letterLabel:IsA("TextLabel") then
					local letter = letterLabel.Text
					if letter and letter ~= "" then
						table.insert(letters, letter:upper())
					end
				end
			else
				break
			end
		end
		
		if #letters > 0 then
			return table.concat(letters, "")
		end
		
		return nil
	end)
	
	if not success then
		return nil
	end
	
	return result
end

-- Monitor UI for letter changes
task.spawn(function()
	local lastDetectedLetters = ""
	task.wait(2)
	
	while task.wait(0.3) do
		if uiAutoComplete then
			local currentLetters = getLettersFromUI()
			
			if currentLetters and currentLetters ~= "" and currentLetters ~= lastDetectedLetters then
				lastDetectedLetters = currentLetters
				lastWordTime = tick()
				searchBox.Text = currentLetters
				notify("Detected: " .. currentLetters)
			end
		else
			if lastDetectedLetters ~= "" then
				lastDetectedLetters = ""
			end
		end
	end
end)

