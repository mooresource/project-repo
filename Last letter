        local letters = extractLetters(message)
        if letters and consoleAutoComplete then
            lastWordTime = tick()
            searchBox.Text = letters
        end
    end
end)

local function getLettersFromUI()
    local success, result = pcall(function()
        local inGameGui = playerGui:FindFirstChild("InGame") 
        if not inGameGui then return nil end
        
        local frame = inGameGui:FindFirstChild("Frame")
        if not frame then return nil end
        
        local currentWord = frame:FindFirstChild("Current word") or 
                           frame:FindFirstChild("Currentword") or 
                           frame:FindFirstChild("CurrentWord")
        
        if not currentWord then
            for _, child in ipairs(frame:GetChildren()) do
                if child:IsA("Frame") and child:FindFirstChild("1") then
                    currentWord = child
                    break
                end
            end
        end
        
        if not currentWord then return nil end
        
        local letters = {}
        for i = 1, 20 do
            local letterFrame = currentWord:FindFirstChild(tostring(i))
            if letterFrame then
                local letterLabel = letterFrame:FindFirstChild("Letter")
                if letterLabel and letterLabel:IsA("TextLabel") then
                    local letter = letterLabel.Text
                    if letter and letter ~= "" then
                        table.insert(letters, letter:upper())
                    end
                end
            else
                break
            end
        end
        
        return #letters > 0 and table.concat(letters, "") or nil
    end)
    
    return success and result or nil
end

