                topWords = {}
                displayPage()
            end
        end)
    end
end

local function updateTopWords(input)
    topWords = {}
    input = input:lower()
    
    if input == "" then
        displayPage()
        return
    end

    local candidateWords = wordsByPrefix[input] or allWords
    local maxResults = 100
    local count = 0
    
    for _, w in ipairs(candidateWords) do
        if count >= maxResults then break end
        if w:sub(1, #input) == input and w ~= input then
            table.insert(topWords, w)
            count = count + 1
        end
    end

    table.sort(topWords, function(a, b)
        local aBanned = bannedWords[a] or false
        local bBanned = bannedWords[b] or false
        local aUsed = usedWords[a] or false
        local bUsed = usedWords[b] or false
        
        -- Priority: non-banned > non-used > ideal length
        if aBanned ~= bBanned then
            return not aBanned
        end
        
        if aUsed ~= bUsed then
            return not aUsed
        end
        
        local lenA, lenB = #a, #b
        local distA = math.abs(lenA - CONFIG.idealLength)
        local distB = math.abs(lenB - CONFIG.idealLength)
        if distA == distB then return lenA < lenB end
        return distA < distB
    end)

    currentPage = 1
    displayPage()
    
    -- Update counters
    local bannedCount = 0
    for _ in pairs(bannedWords) do
        bannedCount = bannedCount + 1
    end
    retryLabel.Text = "Banned Words: " .. bannedCount
    
    local usedCount = 0
    for _ in pairs(usedWords) do
        usedCount = usedCount + 1
    end
    usageLabel.Text = "Used Words: " .. usedCount
end

local function isMyTurn()
	local success, result = pcall(function()
		local inGameGui = playerGui:FindFirstChild("InGame")
		if not inGameGui then return false end
		
		local frame = inGameGui:FindFirstChild("Frame")
		if not frame then return false end
		
		local typeLabel = frame:FindFirstChild("Type")
		if not typeLabel or not typeLabel:IsA("TextLabel") then return false end
		
		local text = typeLabel.Text
		local myName = player.Name
		
		return string.find(text, myName) ~= nil
	end)
	
	return success and result or false
end

local function getWrongTryCount()
    local success, count = pcall(function()
        local inGameGui = playerGui:FindFirstChild("InGame")
        if not inGameGui then return 0 end
        
        local frame = inGameGui:FindFirstChild("Frame")
        if not frame then return 0 end
        
        local tries = frame:FindFirstChild("Tries")
        if not tries then return 0 end
        
        local wrongCount = 0
        for i = 1, 5 do
            local tryImage = tries:FindFirstChild(tostring(i))
            if tryImage and tryImage:IsA("ImageLabel") then
                if tryImage.Image == WRONG_ANSWER_IMAGE then
                    wrongCount = wrongCount + 1
                end
            end
        end
        
        return wrongCount
    end)
    
    return success and count or 0
end

