        local ClickBtn = Instance.new("TextButton")
        ClickBtn.Size = UDim2.new(0, 36, 0, 26)
        ClickBtn.Position = UDim2.new(1, -60, 0.5, -13)
        ClickBtn.BackgroundColor3 = Constants.COLORS.Primary
        ClickBtn.Text = "SEL"
        ClickBtn.Font = Enum.Font.GothamBold
        ClickBtn.TextSize = 10
        ClickBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        ClickBtn.Parent = Container
        Instance.new("UICorner", ClickBtn).CornerRadius = UDim.new(0, 6)
        
        InputBox.Position = UDim2.new(1, -145, 0.5, -13)
        
        ClickBtn.MouseEnter:Connect(function()
            TweenObject(ClickBtn, {BackgroundColor3 = Constants.COLORS.PrimaryDim}, 0.15)
        end)
        
        ClickBtn.MouseLeave:Connect(function()
            TweenObject(ClickBtn, {BackgroundColor3 = Constants.COLORS.Primary}, 0.15)
        end)
        
        ClickBtn.MouseButton1Click:Connect(function()
            GUIBuilder.EnableClickToTarget(InputBox)
        end)
