    local btn = create("TextButton", {Parent = frame, Size = UDim2.new(0, 70, 0, 22), Position = UDim2.new(1, -100, 0.5, -11), BackgroundColor3 = Color3.fromRGB(35, 35, 42), Text = _G.Config[keyConfigKey] and _G.Config[keyConfigKey].Name or "None", TextColor3 = Color3.fromRGB(220, 220, 230), TextSize = 10, Font = Enum.Font.GothamMedium, BorderSizePixel = 0})
    create("UICorner", {Parent = btn, CornerRadius = UDim.new(0, 5)})
    btn.MouseButton1Click:Connect(function()
        btn.Text = "..."
        btn.TextColor3 = Color3.fromRGB(255, 68, 68)
        state.bindingKey = {keyConfigKey = keyConfigKey, btn = btn}
    end)
    local clearBtn = create("TextButton", {Parent = frame, Size = UDim2.new(0, 22, 0, 22), Position = UDim2.new(1, -24, 0.5, -11), BackgroundColor3 = Color3.fromRGB(255, 68, 68), Text = "×", TextColor3 = Color3.fromRGB(255, 255, 255), TextSize = 16, Font = Enum.Font.GothamBold, BorderSizePixel = 0})
    create("UICorner", {Parent = clearBtn, CornerRadius = UDim.new(0, 5)})
    clearBtn.MouseButton1Click:Connect(function()
        _G.Config[keyConfigKey] = nil
        btn.Text = "None"
        btn.TextColor3 = Color3.fromRGB(220, 220, 230)
    end)
end

