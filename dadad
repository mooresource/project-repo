local function CreateTab(name)
    local btn = create("TextButton", {Parent = TabBar, Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = Color3.fromRGB(25, 25, 32), BorderSizePixel = 0, Text = "", AutoButtonColor = false})
    create("UICorner", {Parent = btn, CornerRadius = UDim.new(0, 8)})
