    local frame = create("Frame", {Parent = Tabs[tab], Size = UDim2.new(1, -8, 0, 32), BackgroundColor3 = Color3.fromRGB(25, 25, 32), BorderSizePixel = 0})
    create("UICorner", {Parent = frame, CornerRadius = UDim.new(0, 6)})
