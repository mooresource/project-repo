    create("UICorner", {Parent = Highlight, CornerRadius = UDim.new(1, 0)})
    local label = create("TextLabel", {Parent = btn, Size = UDim2.new(1, -20, 1, 0), Position = UDim2.new(0, 14, 0, 0), Text = name, TextColor3 = Color3.fromRGB(150, 150, 160), TextSize = 13, Font = Enum.Font.GothamSemibold, BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left})
    local tabContainer = create("Frame", {Parent = Content, Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1, Visible = false})
    local tabLayout = create("UIListLayout", {Parent = tabContainer, Padding = UDim.new(0, 8)})
    tabLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() tabContainer.Size = UDim2.new(1, 0, 0, tabLayout.AbsoluteContentSize.Y) end)
    Tabs[name] = tabContainer
    btn.MouseEnter:Connect(function() if currentTab ~= name then TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(30, 30, 38)}):Play() end end)
    btn.MouseLeave:Connect(function() if currentTab ~= name then TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(25, 25, 32)}):Play() end end)
    btn.MouseButton1Click:Connect(function()
        for _, t in pairs(TabBar:GetChildren()) do
            if t:IsA("TextButton") then
                TweenService:Create(t, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(25, 25, 32)}):Play()
                t:FindFirstChild("TextLabel").TextColor3 = Color3.fromRGB(150, 150, 160)
                if t:FindFirstChild("Frame") then t.Frame.Visible = false end
            end
        end
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(255, 68, 68)}):Play()
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
        Highlight.Visible = true
        for _, container in pairs(Tabs) do container.Visible = false end
        Tabs[name].Visible = true
        currentTab = name
    end)
    if not currentTab then
        btn.BackgroundColor3 = Color3.fromRGB(255, 68, 68)
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
        Highlight.Visible = true
        Tabs[name].Visible = true
        currentTab = name
    end
end

